{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "contabo-mcp": {
      "release-type": "node",
      "package-name": "@kieksme/contabo-mcp",
      "versioning": "default",
      "include-v-in-tag": false,
      "include-v-in-release-name": false,
      "include-component-in-tag": false,
      "component-no-space": true,
      "pull-request-title-pattern": "chore${scope}: release ${version}",
      "skip-github-release": false,
      "force-tag-creation": true,
      "changelog-sections": [
        { "type": "feat", "section": "Added" },
        { "type": "feature", "section": "Added" },
        { "type": "fix", "section": "Fixed" },
        { "type": "perf", "section": "Changed" },
        { "type": "revert", "section": "Changed" },
        { "type": "docs", "section": "Changed" },
        { "type": "refactor", "section": "Changed" },
        { "type": "style", "section": "Changed" },
        { "type": "test", "section": "Changed" },
        { "type": "build", "section": "Changed" },
        { "type": "ci", "section": "Changed" },
        { "type": "chore", "section": "Changed" },
        { "type": "deps", "section": "Changed" },
        { "type": "security", "section": "Security" }
      ]
    }
  }
}
