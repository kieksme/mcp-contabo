# --- Contabo API credentials (same as contabo-mcp) ---
# copy from https://my.contabo.com/api/details
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# --- Claude API (chat agent) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
# DASHBOARD_AGENT_MODEL=claude-sonnet-5
# Optional override; comma-separated MCP tool-name prefixes the chat agent may call.
# Defaults to "contabo_instances_,contabo_snapshots_".
# DASHBOARD_AGENT_TOOL_PREFIXES=contabo_instances_,contabo_snapshots_

# --- Dashboard auth ---
# Shared secret entered on the login page. Generate with: openssl rand -hex 32
DASHBOARD_AUTH_TOKEN=
# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# --- Server ---
# PORT=3000
