# Required — copy from https://my.contabo.com/api/details (see README.md#obtaining-api-credentials)
# CONTABO_CLIENT_ID     = Customer ID / Kunden-ID (e.g. DE-XXXX)
# CONTABO_CLIENT_SECRET = Client-Secret (full value, not the masked dots)
# CONTABO_API_USER      = Username / Benutzername (API user email)
# CONTABO_API_PASSWORD  = API password you set on that page (not your login password)
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=

# Optional overrides (must use *.contabo.com hosts unless custom hosts are enabled)
# CONTABO_API_BASE_URL=https://api.contabo.com/v1
# CONTABO_AUTH_URL=https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token
# CONTABO_ALLOW_CUSTOM_HOSTS=true

# Dev only: skip OAuth if you already have a bearer token
# CONTABO_ACCESS_TOKEN=
