{
  "mcpServers": {
    "contabo": {
      "command": "npx",
      "args": ["-y", "contabo-mcp"],
      "env": {
        "CONTABO_CLIENT_ID": "",
        "CONTABO_CLIENT_SECRET": "",
        "CONTABO_API_USER": "",
        "CONTABO_API_PASSWORD": ""
      }
    },
    "contabo-from-github": {
      "command": "npx",
      "args": [
        "-y",
        "--package=git+https://github.com/kieksme/mcp-contabo.git#main",
        "contabo-mcp"
      ],
      "env": {
        "CONTABO_CLIENT_ID": "",
        "CONTABO_CLIENT_SECRET": "",
        "CONTABO_API_USER": "",
        "CONTABO_API_PASSWORD": ""
      }
    },
    "contabo-local-clone": {
      "command": "node",
      "args": ["/absolute/path/to/contabo-mcp/dist/index.js"],
      "env": {
        "CONTABO_CLIENT_ID": "",
        "CONTABO_CLIENT_SECRET": "",
        "CONTABO_API_USER": "",
        "CONTABO_API_PASSWORD": ""
      }
    }
  }
}
