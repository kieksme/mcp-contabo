{
  "name": "@kieksme/contabo-mcp",
  "version": "1.2.0",
  "description": "MCP server for the Contabo API (VMs, snapshots, object storage, secrets, domains)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "contabo-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:check": "node scripts/pack-check.mjs",
    "prepublishOnly": "pnpm run build && pnpm test && pnpm run pack:check",
    "fetch-openapi": "tsx scripts/fetch-openapi.ts",
    "generate-types": "openapi-typescript openapi/contabo.openapi.json -o src/generated/contabo.d.ts"
  },
  "keywords": [
    "mcp",
    "contabo",
    "cloud",
    "model-context-protocol"
  ],
  "author": "kieksme",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/mcp-contabo.git",
    "directory": "contabo-mcp"
  },
  "homepage": "https://github.com/kieksme/mcp-contabo#readme",
  "bugs": {
    "url": "https://github.com/kieksme/mcp-contabo/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
